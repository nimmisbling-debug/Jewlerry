# =============================================================================
# Atelier Jewelry — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: SERVER-ONLY. Never expose to the browser or commit it.
# Used only in server actions / route handlers / admin SDK calls that
# deliberately need to bypass RLS (e.g. signed URLs for payment proofs).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Site ---------------------------------------------------------------
# Production: your public domain (e.g. https://www.nimmisbling.com), NOT the
# *.vercel.app URL — Supabase auth email links are built from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Email (SMTP) ---------------------------------------------------------
# Leave SMTP_HOST/SMTP_USER/SMTP_PASSWORD unset in development to use the
# console/log dev transport instead of sending real email (see
# src/lib/email). For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your address, SMTP_PASSWORD=a 16-character app password
# (myaccount.google.com/apppasswords — requires 2-Step Verification, NOT
# your normal Google account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Nimmis Bling <no-reply@nimmisbling.com>"

# --- Admin bootstrap ------------------------------------------------------
# Used only by `npm run seed` to create the first admin account. The admin
# is forced to change this password on first login; it is never read again
# after bootstrap and never exposed through any API.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@123
ADMIN_BOOTSTRAP_EMAIL=admin@atelier.local

# --- Misc -------------------------------------------------------------
# Shared secret checked on scheduled/cron route handlers (e.g. reminder
# emails). Generate with `openssl rand -hex 32`.
CRON_SECRET=
